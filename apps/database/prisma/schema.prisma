// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           String        @id @default(uuid())
  name         String
  password     String
  email        String        @unique
  websites     Website[]
  region       Region[]
  profileImage String?

  @@map("user")
}

model Website {
  id        String          @id @default(uuid())
  name      String
  url       String
  user_id   String?
  timeAdded DateTime        @default(now())
  ticks     WebsiteTick[]
  events    WebEvent[]
  channels  Channel[]
  user      User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("website")
}

model WebEvent {
  id           String       @id @default(uuid())
  name         String
  level        EventLevel   @map("level")
  resolved     Boolean?     @default(false)
  website_id   String
  resolvedTime DateTime
  website      Website      @relation(fields: [website_id], references: [id], onDelete: Cascade)
  timeAdded    DateTime     @default(now())

  @@map("webevents")
}

model Region {
  id      String          @id @default(uuid())
  name    String
  user_id String?
  user    User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ticks   WebsiteTick[]

  @@map("region")
}

model WebsiteTick {
  id               String      @default(uuid())
  response_time_ms Int
  status           WebStatus   @map("status")
  region           Region      @relation(fields: [region_id], references: [id], onDelete: Cascade)
  website          Website     @relation(fields: [website_id], references: [id], onDelete: Cascade)
  region_id        String
  website_id       String
  createdAt        DateTime    @default(now())

  @@id([id, createdAt])
  @@index([createdAt])
  @@map("websitetick")
}

model Channel {
  id             String       @id @default(uuid())
  channelName    String
  channelDetails String
  level          EventLevel   @map("level")
  website_id     String
  monitor        Boolean      @default(true)
  lastSent       DateTime?
  createdAt      DateTime     @default(now())
  website        Website      @relation(fields: [website_id], references: [id], onDelete: Cascade)

  @@map("channel")
}

enum WebStatus {
  up       @map("up")
  down     @map("down")
  degraded @map("degraded")

  @@map("webstatus")
}

enum EventLevel {
  low     @map("low")
  mid     @map("mid")
  high    @map("high")
  threat  @map("threat")

  @@map("eventlevel")
}
